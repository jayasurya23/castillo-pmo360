# ============================================================
# Castillo Meeting Management — environment configuration
# Copy to .env and fill in your values.
# ============================================================

# --- Mode ---
# true  = SQLite + local files (no Azure / Postgres needed)
# false = PostgreSQL + SharePoint (production)
LOCAL_DEV_MODE=true

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Other valid options at time of writing:
#   gpt-4o            (most capable)
#   gpt-4o-mini       (cheap + fast, recommended for parsing)
#   gpt-4.1           (newer, balanced)
# Set to whatever model string OpenAI exposes — code passes it through.

# --- Local dev (used when LOCAL_DEV_MODE=true) ---
SQLITE_PATH=data/castillo.db
LOCAL_OUTPUT_DIR=data/outputs

# --- PostgreSQL (used when LOCAL_DEV_MODE=false) ---
DATABASE_URL=postgresql://user:password@localhost:5432/castillo_meetings

# --- Microsoft Graph / SharePoint (used when LOCAL_DEV_MODE=false) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ROOT_FOLDER=Castillo Meeting Tool

# --- Email (Microsoft Graph) ---
SEND_FROM_EMAIL=pmo@castilloengineering.com

# --- App ---
APP_TITLE=Castillo Meeting Management
APP_PORT=8501
DEFAULT_TIMEZONE=America/New_York
